    "commission": "Partner earnings in the brand's currency, split the same way. approved can go negative after a reversal (for example a cancelled order, see adjustments). null means not reported yet.",
    "conversionRate": "Not stored. (approved + pending conversions) / uniqueClicks. null if clicks are null or 0.",
    "epc": "Earnings per click. Not stored. (approved + pending commission) / uniqueClicks. null if clicks are null or 0.",
    "previousPeriod": "The same metrics for the previous 30 days (conversions and commission as approved + pending, commission in the brand's currency). null if the partnership is newer.",
    "currency": "The brand's payout currency. Multiply by fxToSEK to compare or sum across brands.",
    "market": "One program per market, each with its own id. Names can repeat across markets (Kreditkollen in SE and NO), so key on id.",
    "tracking": "link = clicks on links. voucher = discount-code redemptions (conversions without clicks). app = app installs.",
    "status": "State of the partner's partnership with the brand. Known values: active, paused, closing, ended, under_review. The list is open, so expect others.",
    "statusDetail": "Explains the status in words, or null.",
    "null vs 0": "null is unknown. 0 is zero.",
    "dailyTotals": "One row per day, all brands, approved + pending, commission in SEK."
